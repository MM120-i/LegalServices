# Copy to .env.local. Keep real secrets out of Git and NEXT_PUBLIC_* variables.
# Blank values intentionally leave email delivery disabled in preview.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A plain email address on a domain verified in the Resend account.
CONTACT_FROM_EMAIL=

# Keep false while the site contains samples or unapproved business facts.
SITE_PUBLISHED=false
# Set only after the client owns the final HTTPS domain.
NEXT_PUBLIC_SITE_URL=

# Optional public verification token for a Search Console URL-prefix property.
# A Domain property instead uses the exact DNS record supplied by Google.
GOOGLE_SITE_VERIFICATION=

# Optional: comma-separated exact public origins if a reverse proxy rewrites Host.
# No wildcard hosts; X-Forwarded-Host/Proto are deliberately not trusted.
# Example syntax only: https://your-owned-domain.ca,https://preview.your-owned-domain.ca
CONTACT_ALLOWED_ORIGINS=
