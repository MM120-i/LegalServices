{
  "name": "lexora-legal-services",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:sync": "node scripts/sync-content.mjs",
    "content:check": "node scripts/sync-content.mjs --check && node --experimental-strip-types --test tests/content.test.ts tests/public-content.test.ts",
    "check": "npm test && npm run typecheck && npm run lint",
    "contact:check": "node --experimental-strip-types --test tests/contact.test.ts tests/contact-submissions.test.ts",
    "pages:check": "node --test tests/pages.test.mjs",
    "format": "prettier --write src scripts tests README.md docs",
    "test": "npm run content:check && npm run contact:check && npm run launch:test",
    "qa": "npm run qa:checks && npm run qa:lighthouse",
    "qa:links": "node --experimental-strip-types --test tests/links.test.mjs tests/seo.test.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "qa:checks": "npm run check && node scripts/run-qa.mjs",
    "launch:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/launch-check.mjs",
    "launch:test": "node --experimental-strip-types --test tests/launch.test.ts"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.5.0",
    "linkedom": "^0.18.14",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
